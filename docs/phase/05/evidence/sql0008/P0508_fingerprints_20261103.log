# Empreintes de contenu des objets PRÉEXISTANTS (0001–0007), avant / après 0008, puis après les bancs. Requête (lecture seule) :
#   \pset footer on
#   -- Empreintes de contenu des objets PRÉEXISTANTS (0001-0007). Les objets créés par 0008 sont exclus ;
#   -- imports.batches est hachée sans la colonne ajoutée supplier_id (to_jsonb(x) - 'supplier_id').
#   SELECT table_schema||'.'||table_name AS t,
#     (xpath('/row/c/text()', query_to_xml(format('SELECT count(*) AS c FROM %I.%I', table_schema, table_name), false, true, '')))[1]::text::bigint AS n,
#     (xpath('/row/h/text()', query_to_xml(format('SELECT md5(coalesce(string_agg(%s, E''\n'' ORDER BY %s), '''')) AS h FROM %I.%I x',
#        CASE WHEN table_schema='imports' AND table_name='batches' THEN '(to_jsonb(x) - ''supplier_id'')::text' ELSE 'x::text' END,
#        CASE WHEN table_schema='imports' AND table_name='batches' THEN '(to_jsonb(x) - ''supplier_id'')::text' ELSE 'x::text' END,
#        table_schema, table_name), false, true, '')))[1]::text AS md5
#   FROM information_schema.tables
#   WHERE table_type='BASE TABLE' AND table_schema NOT IN ('pg_catalog','information_schema')
#     AND NOT (table_schema='catalog' AND table_name LIKE 'lens_offer%') AND NOT (table_schema='imports' AND table_name='supplier_profiles')
#   ORDER BY 1;
#   SELECT md5(string_agg(n.nspname||'.'||c.relname||':'||c.relkind::text||':'||pg_get_userbyid(c.relowner)||':'||coalesce(c.relacl::text,'-'), ',' ORDER BY n.nspname, c.relname)) AS objects_md5, count(*) AS objects
#   FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace
#   WHERE n.nspname IN ('public','auth','clients','appointments','audit','optical','org','catalog','pricing','stock','imports')
#     AND c.relname !~ '(lens_offer|supplier_profiles)' AND c.relname <> 'ix_batches_supplier_id';
#   SELECT md5(string_agg(table_schema||'.'||table_name||'.'||column_name||':'||data_type||':'||is_nullable||':'||coalesce(column_default,'-'), ',' ORDER BY table_schema, table_name, ordinal_position)) AS columns_md5, count(*) AS columns
#   FROM information_schema.columns
#   WHERE table_schema IN ('public','auth','clients','appointments','audit','optical','org','catalog','pricing','stock','imports')
#     AND table_name !~ '(lens_offer|supplier_profiles)' AND NOT (table_schema='imports' AND table_name='batches' AND column_name='supplier_id');
#   SELECT md5(string_agg(conrelid::regclass::text||'.'||conname||'='||pg_get_constraintdef(oid), E'\n' ORDER BY conrelid::regclass::text, conname)) AS constraints_md5, count(*) AS constraints
#   FROM pg_constraint
#   WHERE connamespace::regnamespace::text IN ('public','auth','clients','appointments','audit','optical','org','catalog','pricing','stock','imports')
#     AND conrelid::regclass::text !~ '(lens_offer|supplier_profiles)' AND conname <> 'fk_batches_suppliers';
#   SELECT md5(string_agg(tgrelid::regclass::text||'.'||tgname||':'||tgenabled::text||':'||pg_get_triggerdef(oid), ',' ORDER BY tgrelid::regclass::text, tgname)) AS triggers_md5, count(*) AS triggers
#   FROM pg_trigger WHERE NOT tgisinternal AND tgrelid::regclass::text !~ '(lens_offer|supplier_profiles)';
#   SELECT md5(string_agg(p.oid::regprocedure::text||'='||pg_get_functiondef(p.oid), E'\n' ORDER BY p.oid::regprocedure::text)) AS functions_md5, count(*) AS functions
#   FROM pg_proc p JOIN pg_namespace n ON n.oid=p.pronamespace
#   WHERE n.nspname IN ('public','auth','clients','appointments','audit','optical','org','catalog','pricing','stock','imports');
