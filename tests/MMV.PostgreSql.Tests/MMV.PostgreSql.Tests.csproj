<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- Chaîne de test (mmv_v2_test) hors dépôt : %APPDATA%\Microsoft\UserSecrets\mmv-v2-postgresql-tests\secrets.json -->
    <UserSecretsId>mmv-v2-postgresql-tests</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\MMV.Infrastructure\MMV.Infrastructure.csproj" />
    <!-- Phase 02 : pipeline HTTP réel de l'API contre mmv_v2_test (AuthHttpPostgreSqlTests). -->
    <ProjectReference Include="..\..\src\MMV.Api\MMV.Api.csproj" />
    <!-- Phase 02 : politique de cible du bootstrap relue sur les vraies bases (BootstrapTargetPostgreSqlTests) ;
         alias externe : son type Program ne doit pas masquer celui de MMV.Api. -->
    <ProjectReference Include="..\..\src\MMV.Maintenance\MMV.Maintenance.csproj" Aliases="maintenance" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
