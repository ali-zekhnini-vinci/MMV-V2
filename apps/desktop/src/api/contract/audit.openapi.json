{
  "openapi": "3.1.1",
  "paths": {
    "/api/audit/clients/{clientId}": {
      "get": {
        "tags": [
          "Audit"
        ],
        "operationId": "ListClientAuditEvents",
        "parameters": [
          {
            "name": "clientId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "module",
            "in": "query",
            "schema": {
              "enum": [
                "clients",
                "appointments",
                "optical"
              ],
              "type": "string"
            }
          },
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "maximum": 100000,
              "minimum": 1,
              "type": "integer",
              "format": "int32",
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "maximum": 100,
              "minimum": 1,
              "type": "integer",
              "format": "int32",
              "default": 20
            }
          }
        ],
        "responses": {
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditEventPageResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AuditChangeResponse": {
        "required": [
          "field",
          "masked",
          "old",
          "new",
          "oldDisplay",
          "newDisplay"
        ],
        "type": "object",
        "properties": {
          "field": {
            "type": "string"
          },
          "masked": {
            "type": "boolean"
          },
          "old": {
            "type": [
              "null",
              "string"
            ]
          },
          "new": {
            "type": [
              "null",
              "string"
            ]
          },
          "oldDisplay": {
            "type": [
              "null",
              "string"
            ]
          },
          "newDisplay": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "AuditEventPageResponse": {
        "required": [
          "items",
          "page",
          "pageSize",
          "totalCount"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuditEventResponse"
            }
          },
          "page": {
            "type": "integer",
            "format": "int32"
          },
          "pageSize": {
            "type": "integer",
            "format": "int32"
          },
          "totalCount": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "AuditEventResponse": {
        "required": [
          "id",
          "occurredAtUtc",
          "actorUserId",
          "actorDisplayName",
          "module",
          "action",
          "entityType",
          "entityId",
          "changes"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "occurredAtUtc": {
            "type": "string",
            "format": "date-time"
          },
          "actorUserId": {
            "type": "string",
            "format": "uuid"
          },
          "actorDisplayName": {
            "type": "string"
          },
          "module": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "entityType": {
            "type": "string"
          },
          "entityId": {
            "type": "string",
            "format": "uuid"
          },
          "changes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuditChangeResponse"
            }
          }
        }
      },
      "ErrorResponse": {
        "required": [
          "code"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          }
        }
      }
    }
  }
}
